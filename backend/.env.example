# Copie este arquivo para .env e preencha com suas credenciais do Supabase
# NUNCA commite o arquivo .env no git

# URL do seu projeto no Supabase
# Encontre em: Supabase Dashboard > Settings > API > Project URL
# Formato correto: https://xxxxxxxxxxxxxxxxxxx.supabase.co  (SEM /storage/v1/s3 no final)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co

# Chave de serviço (service_role) — tem acesso total, use apenas no backend
# Encontre em: Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
